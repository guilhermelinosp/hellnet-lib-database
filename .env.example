# Example environment for hellnet-lib-database example/ program.
# Copy to .env and fill HELLNET_DATABASE_PASSWORD, then `go run ./example`.
#
# These mirror the .NET Hellnet.Database variables exactly.

HELLNET_DATABASE_HOST=localhost
HELLNET_DATABASE_PORT=5432
HELLNET_DATABASE_NAME=postgres
HELLNET_DATABASE_USERNAME=postgres
HELLNET_DATABASE_PASSWORD=change-me

# Optional tuning (defaults shown):
# HELLNET_DATABASE_POOL_MIN_SIZE=10
# HELLNET_DATABASE_POOL_MAX_SIZE=100
# HELLNET_DATABASE_COMMAND_TIMEOUT_SECONDS=30
# HELLNET_DATABASE_CONNECTION_TIMEOUT_SECONDS=15
# HELLNET_DATABASE_RETRY_ENABLED=true
# HELLNET_DATABASE_RETRY_MAX_COUNT=3
# HELLNET_DATABASE_RETRY_BASE_DELAY_MS=100
# HELLNET_DATABASE_SLOW_QUERY_MS=500
